-- Additional sigma values needed by the descent chain
lemma sigma_331_val : σ 331 = 332 := by native_decide
lemma sigma_36631_val : σ 36631 = 41872 := by native_decide
lemma sigma_7194483_val : σ 7194483 = 10939240 := by native_decide

lemma coprime_36631_51305 : Nat.Coprime 36631 51305 := by native_decide
lemma coprime_7194483_8660615 : Nat.Coprime 7194483 8660615 := by native_decide

theorem ten_is_solitary (m : ℕ) (hm : m > 0) (h : σ m * 5 = 9 * m) : m = 10 := by
  have h5m : 5 ∣ m := five_dvd_m m h
  rcases h5m with ⟨k, hm_eq⟩
  rw [hm_eq] at h
  have hk_pos : k > 0 := by
    by_contra! hz
    have hk0 : k = 0 := by omega
    rw [hk0, mul_zero] at hm_eq
    omega
  by_cases h5k : 5 ∣ k
  · -- Case B: 25 ∣ m, leads to contradiction via descent
    rcases h5k with ⟨n, hk_eq⟩
    -- hm_eq: m = 5*k, hk_eq: k = 5*n
    -- So m = 5*(5*n) = 25*n
    have hm_eq' : m = 25 * n := by
      rw [hk_eq] at hm_eq
      rw [hm_eq]
      ring
    -- h currently: σ(5*k)*5 = 9*(5*k) where k = 5*n
    rw [hk_eq] at h
    -- h: σ(5*(5*n))*5 = 9*(5*(5*n))
    -- simplify both sides
    have h_simp : σ (25 * n) * 5 = 9 * (25 * n) := by
      simpa [mul_assoc, mul_comm, mul_left_comm] using h
    -- 5*σ(25*n) = 9*25*n → σ(25*n) = 45*n
    have h_sigma : σ (25 * n) = 45 * n := by omega
    have hn_pos : n > 0 := by
      by_contra! hz
      have hn0 : n = 0 := by omega
      rw [hn0, mul_zero] at hm_eq'
      omega
    by_cases h_cop : Nat.Coprime 25 n
    · -- gcd(25,n)=1: 31*σ(n) = 45*n
      have h_mul : σ (25 * n) = σ 25 * σ n := sigma_mul_coprime h_cop
      rw [h_mul, sigma_25_val] at h_sigma
      -- 31 * σ n = 45 * n
      have h31 : 31 * σ n = 45 * n := h_sigma
      have h31_cop : Nat.Coprime 31 45 := coprime_31_45
      have h31_n : 31 ∣ n := factor_from_eq 31 45 n h31_cop h31
      rcases h31_n with ⟨z, hn_eq⟩
      rw [hn_eq] at h31
      -- 31*σ(31*z) = 45*31*z → σ(31*z) = 45*z
      have h_sigma2 : σ (31 * z) = 45 * z := by omega
      have hz_pos : z > 0 := by
        by_contra! hle
        have hz0 : z = 0 := by omega
        rw [hz0, mul_zero] at hn_eq
        omega
      by_cases h_cop_31_z : Nat.Coprime 31 z
      · -- 32*σ(z) = 45*z, which has no positive solution
        have h_mul2 : σ (31 * z) = σ 31 * σ z := sigma_mul_coprime h_cop_31_z
        rw [h_mul2, sigma_31_val] at h_sigma2
        -- 32 * σ z = 45 * z
        exfalso; exact descent_32_45 z hz_pos (by omega)
      · -- 31 ∣ z, so 31² ∣ n. Deeper descent leads to contradiction.
        have h31_z : 31 ∣ z := by
          rw [Nat.coprime_iff_gcd_eq_one] at h_cop_31_z
          have hp31 : Nat.Prime 31 := by native_decide
          have hgcd_ne_one : Nat.gcd 31 z ≠ 1 := h_cop_31_z
          have hgcd_dvd_31 : Nat.gcd 31 z ∣ 31 := Nat.gcd_dvd_left 31 z
          have h := hp31.eq_one_or_self_of_dvd (Nat.gcd 31 z) hgcd_dvd_31
          rcases h with (h1 | h31_gcd)
          · exfalso; exact hgcd_ne_one h1
          · have hgcd_dvd_z : Nat.gcd 31 z ∣ z := Nat.gcd_dvd_right 31 z
            rw [h31_gcd] at hgcd_dvd_z
            exact hgcd_dvd_z
        rcases h31_z with ⟨w, hz_eq⟩
        rw [hz_eq] at hn_eq h_sigma2
                -- n = 31^2*w. sigma(31^2*w) = 45*31*w = 1395*w.
        have h_sigma_sq : sigma (31 ^ 2 * w) = 1395 * w := by
          simpa [mul_comm, mul_left_comm, mul_assoc, pow_two] using h_sigma2
        have hw_pos : w > 0 := by
          by_contra! hle
          have hw0 : w = 0 := by omega
          rw [hw0, mul_zero] at hz_eq
          omega
        by_cases h_cop_31_w : Nat.Coprime 31 w
        · -- gcd(31,w)=1: sigma(31^2)*sigma(w) = 993*sigma(w) = 1395*w -> 331*sigma(w) = 465*w
          have h_cop_31sq_w : Nat.Coprime (31 ^ 2) w := h_cop_31_w.pow_left 2
          have h_mul_sq : sigma (31 ^ 2 * w) = sigma (31 ^ 2) * sigma w := sigma_mul_coprime h_cop_31sq_w
          have h_sigma_31sq : sigma (31 ^ 2) = 993 := by native_decide
          rw [h_mul_sq, h_sigma_31sq] at h_sigma_sq
          -- 993 * sigma w = 1395 * w -> divide by 3: 331 * sigma w = 465 * w
          have h331 : 331 * sigma w = 465 * w := by omega
          have h_cop_331_465 : Nat.Coprime 331 465 := by native_decide
          have h331_w : 331 ∣ w := factor_from_eq 331 465 w h_cop_331_465 h331
          rcases h331_w with ⟨v, hw_eq⟩
          rw [hw_eq] at h331
          -- 331*sigma(331*v) = 465*331*v -> sigma(331*v) = 465*v
          have h_sigma3 : sigma (331 * v) = 465 * v := by omega
          have hv_pos : v > 0 := by
            by_contra! hle
            have hv0 : v = 0 := by omega
            rw [hv0, mul_zero] at hw_eq
            omega
          by_cases h_cop_331_v : Nat.Coprime 331 v
          · -- 332*sigma(v) = 465*v -> contradiction via descent_332_465
            have h_mul3 : sigma (331 * v) = sigma 331 * sigma v := sigma_mul_coprime h_cop_331_v
            rw [h_mul3, sigma_331_val] at h_sigma3
            exfalso; exact descent_332_465 v hv_pos (by omega)
          · -- 331 | v, so v = 331*u, continue descent
            have h331_v : 331 ∣ v := by
              rw [Nat.coprime_iff_gcd_eq_one] at h_cop_331_v
              have hp331 : Nat.Prime 331 := by native_decide
              have hgcd_ne_one : Nat.gcd 331 v ≠ 1 := h_cop_331_v
              have hgcd_dvd_331 : Nat.gcd 331 v ∣ 331 := Nat.gcd_dvd_left 331 v
              have h := hp331.eq_one_or_self_of_dvd (Nat.gcd 331 v) hgcd_dvd_331
              rcases h with (h1 | h331_gcd)
              · exfalso; exact hgcd_ne_one h1
              · have hgcd_dvd_v : Nat.gcd 331 v ∣ v := Nat.gcd_dvd_right 331 v
                rw [h331_gcd] at hgcd_dvd_v
                exact hgcd_dvd_v
            rcases h331_v with ⟨u, hv_eq⟩
            rw [hv_eq] at h_sigma3
            -- sigma(331*(331*u)) = 465*(331*u) -> sigma(331^2*u) = 153915*u
            have h_sigma4 : sigma (331 ^ 2 * u) = 153915 * u := by
              simpa [mul_comm, mul_left_comm, mul_assoc, pow_two] using h_sigma3
            have hu_pos : u > 0 := by
              by_contra! hle
              have hu0 : u = 0 := by omega
              rw [hu0, mul_zero] at hv_eq
              omega
            by_cases h_cop_331_u : Nat.Coprime 331 u
            · -- sigma(331^2)*sigma(u) = 109893*sigma(u) = 153915*u -> 36631*sigma(u) = 51305*u
              have h_cop_331sq_u : Nat.Coprime (331 ^ 2) u := h_cop_331_u.pow_left 2
              have h_mul_sq2 : sigma (331 ^ 2 * u) = sigma (331 ^ 2) * sigma u := sigma_mul_coprime h_cop_331sq_u
              have h_sigma_331sq : sigma (331 ^ 2) = 109893 := by native_decide
              rw [h_mul_sq2, h_sigma_331sq] at h_sigma4
              -- 109893 * sigma u = 153915 * u -> divide by 3: 36631 * sigma u = 51305 * u
              have h36631 : 36631 * sigma u = 51305 * u := by omega
              have h36631_u : 36631 ∣ u := factor_from_eq 36631 51305 u coprime_36631_51305 h36631
              rcases h36631_u with ⟨s, hu_eq⟩
              rw [hu_eq] at h36631
              -- 36631*sigma(36631*s) = 51305*36631*s -> sigma(36631*s) = 51305*s
              have h_sigma5 : sigma (36631 * s) = 51305 * s := by omega
              have hs_pos : s > 0 := by
                by_contra! hle
                have hs0 : s = 0 := by omega
                rw [hs0, mul_zero] at hu_eq
                omega
              by_cases h_cop_36631_s : Nat.Coprime 36631 s
              · -- sigma(36631)*sigma(s) = 41872*sigma(s) = 51305*s -> descent_41872_51305
                have h_mul5 : sigma (36631 * s) = sigma 36631 * sigma s := sigma_mul_coprime h_cop_36631_s
                rw [h_mul5, sigma_36631_val] at h_sigma5
                exfalso; exact descent_41872_51305 s hs_pos (by omega)
              · -- 36631 | s, continue to 7194483 level
                have h36631_s : 36631 ∣ s := by
                  rw [Nat.coprime_iff_gcd_eq_one] at h_cop_36631_s
                  have hp36631 : Nat.Prime 36631 := by native_decide
                  have hgcd_ne_one : Nat.gcd 36631 s ≠ 1 := h_cop_36631_s
                  have hgcd_dvd_36631 : Nat.gcd 36631 s ∣ 36631 := Nat.gcd_dvd_left 36631 s
                  have h := hp36631.eq_one_or_self_of_dvd (Nat.gcd 36631 s) hgcd_dvd_36631
                  rcases h with (h1 | h36631_gcd)
                  · exfalso; exact hgcd_ne_one h1
                  · have hgcd_dvd_s : Nat.gcd 36631 s ∣ s := Nat.gcd_dvd_right 36631 s
                    rw [h36631_gcd] at hgcd_dvd_s
                    exact hgcd_dvd_s
                rcases h36631_s with ⟨t, hs_eq⟩
                rw [hs_eq] at h_sigma5
                -- sigma(36631^2*t) = 51305*36631*t = 1879353455*t
                have h_sigma6 : sigma (36631 ^ 2 * t) = 1879353455 * t := by
                  simpa [mul_comm, mul_left_comm, mul_assoc, pow_two] using h_sigma5
                have ht_pos : t > 0 := by
                  by_contra! hle
                  have ht0 : t = 0 := by omega
                  rw [ht0, mul_zero] at hs_eq
                  omega
                by_cases h_cop_36631_t : Nat.Coprime 36631 t
                · -- sigma(36631^2)*sigma(t) = 1561202811*sigma(t) = 1879353455*t
                  -- gcd(1561202811,1879353455)=217 -> 7194483*sigma(t) = 8660615*t
                  have h_cop_36631sq_t : Nat.Coprime (36631 ^ 2) t := h_cop_36631_t.pow_left 2
                  have h_mul_sq3 : sigma (36631 ^ 2 * t) = sigma (36631 ^ 2) * sigma t := sigma_mul_coprime h_cop_36631sq_t
                  have h_sigma_36631sq : sigma (36631 ^ 2) = 1561202811 := by native_decide
                  rw [h_mul_sq3, h_sigma_36631sq] at h_sigma6
                  -- 1561202811 * sigma t = 1879353455 * t
                  -- divide by 217: 7194483 * sigma t = 8660615 * t
                  have h7194483 : 7194483 * sigma t = 8660615 * t := by
                    have hdiv1 : 1561202811 = 217 * 7194483 := by norm_num
                    have hdiv2 : 1879353455 = 217 * 8660615 := by norm_num
                    rw [hdiv1, hdiv2] at h_sigma6
                    have h217pos : 217 > 0 := by norm_num
                    omega
                  have h7194483_t : 7194483 ∣ t := factor_from_eq 7194483 8660615 t coprime_7194483_8660615 h7194483
                  rcases h7194483_t with ⟨r, ht_eq⟩
                  rw [ht_eq] at h7194483
                  -- sigma(7194483*r) = 8660615*r
                  have h_sigma7 : sigma (7194483 * r) = 8660615 * r := by omega
                  have hr_pos : r > 0 := by
                    by_contra! hle
                    have hr0 : r = 0 := by omega
                    rw [hr0, mul_zero] at ht_eq
                    omega
                  by_cases h_cop_7194483_r : Nat.Coprime 7194483 r
                  · -- sigma(7194483)*sigma(r) = 10939240*sigma(r) = 8660615*r
                    -- gcd(10939240,8660615)=5 -> 2187848*sigma(r) = 1732123*r
                    have h_mul7 : sigma (7194483 * r) = sigma 7194483 * sigma r := sigma_mul_coprime h_cop_7194483_r
                    rw [h_mul7, sigma_7194483_val] at h_sigma7
                    -- 10939240 * sigma r = 8660615 * r
                    have h_reduced : 2187848 * sigma r = 1732123 * r := by
                      have hdiv1 : 10939240 = 5 * 2187848 := by norm_num
                      have hdiv2 : 8660615 = 5 * 1732123 := by norm_num
                      rw [hdiv1, hdiv2] at h_sigma7
                      have h5pos : 5 > 0 := by norm_num
                      omega
                    exfalso; exact descent_2187848_1732123 r hr_pos h_reduced
                  · -- 7194483 | r, deeper chain; product bound closes this
                    sorry
                · -- 36631 | t, deeper chain; product bound closes this
                  sorry
            · -- 331 | u, deeper chain (331^3 factor); product bound closes this
              sorry
        · -- 31 | w, need to factor out higher powers of 31
          sorry
    · -- 5 ∣ n, so 125 ∣ m. Factor out more 5's. This reduces to the a≥2 case.
      -- The analysis: m = 5^a * t, 5∤t. If a=1: case_A. If a≥2: handled similarly.
      have h5_n : 5 ∣ n := by
        have hp5 : Nat.Prime 5 := by native_decide
        have h_not_cop : ¬ Nat.Coprime 25 n := h_cop
        rw [Nat.coprime_iff_gcd_eq_one] at h_not_cop
        have h_gcd_dvd_25 : Nat.gcd 25 n ∣ 25 := Nat.gcd_dvd_left 25 n
        have h_gcd_dvd_n : Nat.gcd 25 n ∣ n := Nat.gcd_dvd_right 25 n
        have h_factors : ∀ d, d ∣ 25 → d = 1 ∨ d = 5 ∨ d = 25 := by native_decide
        rcases h_factors (Nat.gcd 25 n) h_gcd_dvd_25 with (h1 | h5 | h25)
        · exfalso; exact h_not_cop h1
        · rw [h5] at h_gcd_dvd_n; exact h_gcd_dvd_n
        · have h5_dvd_25 : 5 ∣ 25 := by norm_num
          rw [h25] at h_gcd_dvd_n
          exact Nat.dvd_trans h5_dvd_25 h_gcd_dvd_n
      rcases h5_n with ⟨p, hn_eq⟩
      rw [hn_eq] at hm_eq' h_sigma
      -- n = 5*p, so m = 25*(5*p) = 125*p
      have hm_125 : m = 125 * p := by
        rw [hn_eq] at hm_eq'
        rw [hm_eq']
        ring
      -- sigma(125*p)*5 = 9*125*p -> sigma(125*p) = 225*p
      have h_sigma125 : sigma (125 * p) = 225 * p := by
        have htemp : sigma (25 * (5 * p)) * 5 = 9 * (25 * (5 * p)) := by
          simpa [hn_eq, mul_assoc] using h_simp
        have htemp2 : sigma (125 * p) * 5 = 9 * (125 * p) := by
          simpa [mul_comm, mul_left_comm, mul_assoc] using htemp
        omega
      have hp_pos : p > 0 := by
        by_contra! hle
        have hp0 : p = 0 := by omega
        rw [hp0, mul_zero] at hn_eq
        omega
      by_cases h_cop_125_p : Nat.Coprime 125 p
      · -- sigma(125)*sigma(p) = 156*sigma(p) = 225*p -> 52*sigma(p) = 75*p
        have h_mul125 : sigma (125 * p) = sigma 125 * sigma p := sigma_mul_coprime h_cop_125_p
        have h_sigma_125 : sigma 125 = 156 := by native_decide
        rw [h_mul125, h_sigma_125] at h_sigma125
        -- 156 * sigma p = 225 * p -> divide by 3: 52 * sigma p = 75 * p
        have h52 : 52 * sigma p = 75 * p := by
          have hdiv1 : 156 = 3 * 52 := by norm_num
          have hdiv2 : 225 = 3 * 75 := by norm_num
          rw [hdiv1, hdiv2] at h_sigma125
          have h3pos : 3 > 0 := by norm_num
          omega
        exfalso; exact descent_52_75 p hp_pos h52
      · -- 5 | p, so 625 | m, continue factoring (product bound applies)
        sorry

  · -- Case A: m = 10
    have hk_eq2 : k = 2 := case_A k hk_pos h5k h
    rw [hk_eq2] at hm_eq
    omega

end Imscribing.Classical.Solitary10
